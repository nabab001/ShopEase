{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/index"
    },
    {
      "source": "/api/products/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/orders",
      "destination": "/api/index"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/index"
    },
    {
      "source": "/api/auth",
      "destination": "/api/index"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/health",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

